# 本地开发可不配置，默认使用 data/birthhappy.db
# TURSO_DATABASE_URL="file:./data/birthhappy.db"

# 生产环境（Turso）
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# 用于签名登录 Cookie、邮箱验证码和注册表单令牌，生产环境必须设置；生成方式见 README
# AUTH_SECRET="replace-with-a-long-random-string"

# 仅在本机用 http 运行生产构建时设为 false。线上 HTTPS 保持默认即可。
# AUTH_COOKIE_SECURE="false"

# 可选：生产备份下载接口令牌，至少 32 个字符。
# 不配置时 /api/admin/backup 返回 404。配置后请妥善保存，不要公开。
# BACKUP_TOKEN="replace-with-a-long-random-string"

# Resend HTTP 邮件服务（生产环境必填，否则无法发送邮箱验证码）
# RESEND_API_KEY 在 Resend Dashboard → API Keys 创建。
# RESEND_FROM 必须使用已在 Resend 验证过的域名发件地址，例如：
# RESEND_FROM="BirtHappy <noreply@birthappy.cn>"
# 未设置时使用项目默认地址；如果域名未验证，Resend 会拒绝普通收件人。
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM="BirtHappy <noreply@birthappy.cn>"
# RESEND_REPLY_TO="optional-reply@example.com"

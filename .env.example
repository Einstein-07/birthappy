# 本地开发可不配置，默认使用 data/birthhappy.db
# TURSO_DATABASE_URL="file:./data/birthhappy.db"

# 生产环境（Turso）
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# 用于签名登录 Cookie，生产环境必须设置；生成方式见 README
# AUTH_SECRET="replace-with-a-long-random-string"

# 仅在本机用 http 运行生产构建时设为 false。线上 HTTPS 保持默认即可。
# AUTH_COOKIE_SECURE="false"

# 本地开发可不配置，默认使用 data/birthhappy.db
# TURSO_DATABASE_URL="file:./data/birthhappy.db"

# 生产环境（Turso）
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# 用于签名登录 Cookie、邮箱验证码和注册表单令牌，生产环境必须设置；生成方式见 README
# AUTH_SECRET="replace-with-a-long-random-string"

# 仅在本机用 http 运行生产构建时设为 false。线上 HTTPS 保持默认即可。
# AUTH_COOKIE_SECURE="false"

# 可选：生产备份下载接口令牌，至少 32 个字符。
# 不配置时 /api/admin/backup 返回 404。配置后请妥善保存，不要公开。
# BACKUP_TOKEN="replace-with-a-long-random-string"

# QQ 邮箱 SMTP（生产环境必填，否则无法发送邮箱验证码）
# MAIL_HOST 默认 smtp.qq.com，MAIL_PORT 默认 465，MAIL_SECURE 默认 true。
# MAIL_PASS 是 QQ 邮箱开启 SMTP 服务后生成的授权码，不是 QQ 登录密码。
# MAIL_USER="2597530663@qq.com"
# MAIL_PASS="replace-with-qq-smtp-authorization-code"
# MAIL_FROM_NAME="BirtHappy"
